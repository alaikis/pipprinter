<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 是最新 LTS；保持 WinForms 桌面应用 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      WPF 仅用于内置 XPS 写入（Services/XpsWriterService.cs，System.Windows.Xps.Packaging），
      使「打印到 XPS」不依赖 Windows 可选功能 Microsoft XPS Document Writer。
      托盘 UI 仍是 WinForms，WPF Application 未启动，XPS 写入在独立 STA 线程执行。
    -->
    <UseWPF>true</UseWPF>
    <AssemblyName>PipPrinter</AssemblyName>
    <RootNamespace>PipPrinter</RootNamespace>
    <AssemblyTitle>荔枝打印助手</AssemblyTitle>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <!-- 版本规范 vMAJOR.FEATURE.PATCH：补丁版递增 PATCH(001→002)，大变更递增 FEATURE(1.01.000)，重大重构递增 MAJOR -->
    <Version>1.01.007</Version>
    <AssemblyVersion>1.1.0.7</AssemblyVersion>
    <FileVersion>1.1.0.7</FileVersion>
    <Product>Lychee Printing Assistant</Product>
    <Description>Lychee Printing Assistant / 荔枝打印助手 — 托盘常驻的本地打印助手</Description>
    <!-- exe 文件图标（资源管理器/桌面/任务栏显示） -->
    <ApplicationIcon>Resource\app.ico</ApplicationIcon>
    <Company>Alaikis.com Inc</Company>
    <Authors>Alaikis.com Inc</Authors>
    <Copyright>© 2026 Alaikis.com Inc. All rights reserved.</Copyright>
    <!-- iTextSharp / BouncyCastle 是 .NET Framework 兼容包，NU1701 属预期 -->
    <NoWarn>$(NoWarn);NU1701;WFO5001</NoWarn>
    <!--
      AoRelay 是解决方案中的独立项目（子目录），其 obj/bin 与源码不应被本项目的
      **/*.cs、**/* 默认 glob 误收，否则会把 AoRelay 的 AssemblyInfo 编进主程序集。
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);AoRelay/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Kestrel / ASP.NET Core minimal API 用于内嵌 Web 文档服务，版本随 .NET 10 共享框架 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Fleck 已移除：WebSocket 服务端迁移到 ASP.NET Core 原生实现（见 Services/WsHub.cs），
      客户端使用 BCL ClientWebSocket（见 Services/AoClientService.cs）。
    -->
    <!-- iTextSharp 最新稳定版（保留作 PDF 内容解析扩展点，NU1701 已知） -->
    <PackageReference Include="iTextSharp" Version="5.5.13.6" />
    <!-- log4net 2.x 最新稳定版；v3 改命名空间且会破坏现有 appender 配置 -->
    <PackageReference Include="log4net" Version="2.0.17" />
    <!-- Newtonsoft.Json 最新稳定版；14.x 仍为 beta -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!--
      SVG 渲染（打印 SVG 文件用）。相比 headless 浏览器转 PDF 更可靠：
      不依赖 Edge/Chrome 后台进程与用户配置，直接渲染成位图后走 GDI+ 打印管线。
    -->
    <PackageReference Include="Svg" Version="3.4.7" />
    <!-- 本机指纹：Win32_Volume 取卷序列号（WMI） -->
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <!--
      移除 Microsoft.Extensions.Logging.Log4Net.AspNetCore：
      1) 项目从未使用 AddLog4Net()，属死依赖；
      2) 其 10.0.0 版本强制依赖 log4net >= 3.3.0，与本项目 log4net 2.x 冲突；
      3) 8.0.0 会把 ASP.NET Core 8 程序集带入 net10 应用，存在版本冲突风险。
    -->
  </ItemGroup>

  <ItemGroup>
    <None Update="pdfreader\SumatraPDF.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Office 转换器（LibreOffice 便携版）：构建时可选注入 office-converter/ 目录，
         安装器会把内容写入 lib/office/；未注入时该目录为空，运行时回退到系统 LibreOffice -->
    <None Update="office-converter\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resource\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resource\tray.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resource\icon-256.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Remove="log4net.config" />
    <None Update="config\log4net.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="config\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="docs\web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Views\Home.resx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
