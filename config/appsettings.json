{
  "wsHost": "0.0.0.0",
  "wsPort": 19860,
  "webHost": "127.0.0.1",
  "webPort": 19861,
  "defaultPrinter": "",
  "autoStart": true,
  "logLevel": "DEBUG",
  "cleanMaxAgeDays": 7,
  "cleanMinSizeMB": 1,
  "useRecycleBin": true,
  "machineId": "",
  "updateManifestUrl": "https://gitee.com/alaikiscom/pipprinter/releases/latest",
  "language": "auto",
  "allowedCommands": [
    "PrintPdf",
    "PrintFile",
    "TemplatePrint",
    "QueuePrint",
    "GetQueue",
    "RetryJob",
    "CancelJob",
    "ClearQueue",
    "GetPrinterList",
    "GetPrinterDetail",
    "SetDefaultPrinter",
    "PrintTestPage",
    "GetPdfDriverConfig",
    "SetPdfPrintDriverConfig",
    "ScanDisk",
    "CleanDisk",
    "GetDiskInfo",
    "GetSettings",
    "SaveSettings",
    "GetStatus",
    "GetMachineFingerprint",
    "CheckUpdate",
    "ApplyUpdate"
  ],
  "cleanWhitelist": [
    "%WINDIR%",
    "%PROGRAMFILES%",
    "%PROGRAMFILES(X86)%",
    "%USERPROFILE%\\Desktop",
    "%USERPROFILE%\\Documents",
    "%USERPROFILE%\\Downloads",
    "%APPDATA%"
  ]
}
